% Load the graphic into a measurable box before adding protection. The final
% box contains both the original, unmodified art and computed empty margins.
\cs_new_protected:Npn \__ieeecs_load_artwork:
  {
    \hbox_set:Nn \l__ieeecs_artwork_box
      {
        \includegraphics
          [ width = \l__ieeecs_artwork_width_tl ]
          { \l__ieeecs_artwork_file_tl }
      }
  }

\cs_new_protected:Npn \__ieeecs_use_artwork:
  {
    \mode_leave_vertical:
    \dim_compare:nNnTF
      {
        \l__ieeecs_artwork_hpad_dim
        + \l__ieeecs_artwork_vpad_dim
      }
      > { 0pt }
      {
        \vbox:n
          {
            \kern \l__ieeecs_artwork_vpad_dim
            \hbox:n
              {
                \kern \l__ieeecs_artwork_hpad_dim
                \box_use:N \l__ieeecs_artwork_box
                \kern \l__ieeecs_artwork_hpad_dim
              }
            \kern \l__ieeecs_artwork_vpad_dim
          }
      }
      { \box_use:N \l__ieeecs_artwork_box }
  }

\cs_new_protected:Npn \__ieeecs_typeset_artwork:
  {
    \__ieeecs_load_artwork:
    \dim_set:Nn \l__ieeecs_artwork_hpad_dim
      { \l__ieeecs_artwork_ratio_tl \box_ht:N \l__ieeecs_artwork_box }
    \dim_set_eq:NN
      \l__ieeecs_artwork_vpad_dim
      \l__ieeecs_artwork_hpad_dim
    \__ieeecs_use_artwork:
  }

\cs_new_protected:Npn \__ieeecs_prepare_ufg_artwork:
  {
    \dim_set:Nn \l__ieeecs_artwork_width_dim
      { \l__ieeecs_artwork_width_tl }
    \tl_if_eq:NnTF \l__ieeecs_ufg_orientation_tl { horizontal }
      {
        \dim_compare:nNnT
          { \l__ieeecs_artwork_width_dim } < { 24.5mm }
          {
            \msg_warning:nnnn
              { ieeeufgcs-brand }
              { ufg-logo-too-small }
              { horizontal }
              { 24.5mm }
          }
        % x = 10.5575 pt in the 385 pt-wide normalized artwork.
        \dim_set:Nn \l__ieeecs_artwork_x_dim
          { 0.027422 \l__ieeecs_artwork_width_dim }
      }
      {
        \dim_compare:nNnT
          { \l__ieeecs_artwork_width_dim } < { 12mm }
          {
            \msg_warning:nnnn
              { ieeeufgcs-brand }
              { ufg-logo-too-small }
              { vertical }
              { 12mm }
          }
        % x = 21.017 pt in the 183 pt-wide normalized artwork.
        \dim_set:Nn \l__ieeecs_artwork_x_dim
          { 0.114847 \l__ieeecs_artwork_width_dim }
      }
    \bool_if:NTF \l__ieeecs_ufg_clear_space_bool
      {
        \dim_set:Nn \l__ieeecs_artwork_hpad_dim
          { 3 \l__ieeecs_artwork_x_dim }
        \dim_set:Nn \l__ieeecs_artwork_vpad_dim
          { 2 \l__ieeecs_artwork_x_dim }
      }
      {
        \dim_zero:N \l__ieeecs_artwork_hpad_dim
        \dim_zero:N \l__ieeecs_artwork_vpad_dim
      }
  }

% Public commands install documented defaults first and then apply user keys.
% Grouping guarantees that all temporary selections are discarded afterward.
\cs_new_protected:Npn \ieeecs_logo:n #1
  {
    \group_begin:
      \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-cs-logo-orange.pdf }
      \tl_set:Nn \l__ieeecs_artwork_width_tl { 45mm }
      \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 0.3 }
      \keys_set:nn { ieeeufgcs / logo } { #1 }
      \__ieeecs_typeset_artwork:
    \group_end:
  }

\cs_new_protected:Npn \ieeecs_master_brand:n #1
  {
    \group_begin:
      \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-master-brand-blue.pdf }
      \tl_set:Nn \l__ieeecs_artwork_width_tl { 55mm }
      \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 1 }
      \keys_set:nn { ieeeufgcs / master-brand } { #1 }
      \__ieeecs_typeset_artwork:
    \group_end:
  }

\cs_new_protected:Npn \ieeecs_ufg_logo:n #1
  {
    \group_begin:
      \tl_set:Nn \l__ieeecs_ufg_orientation_tl { vertical }
      \tl_set:Nn \l__ieeecs_ufg_variant_tl { blue }
      \tl_set:Nn \l__ieeecs_artwork_width_tl { 24mm }
      \bool_set_true:N \l__ieeecs_ufg_clear_space_bool
      \keys_set:nn { ieeeufgcs / ufg-logo } { #1 }
      \tl_set:Nx \l__ieeecs_artwork_file_tl
        {
          ieeeufgcs-ufg-logo-
          \l__ieeecs_ufg_orientation_tl-
          \l__ieeecs_ufg_variant_tl.pdf
        }
      \__ieeecs_load_artwork:
      \__ieeecs_prepare_ufg_artwork:
      \__ieeecs_use_artwork:
    \group_end:
  }

\cs_new_protected:Npn \ieeecs_student_branch_mark:n #1
  {
    \group_begin:
      \tl_set:Nn \l__ieeecs_student_branch_variant_tl { horizontal }
      \tl_clear:N \l__ieeecs_artwork_width_tl
      \keys_set:nn { ieeeufgcs / student-branch } { #1 }
      \str_case:Vn \l__ieeecs_student_branch_variant_tl
        {
          { horizontal }
            {
              \tl_set:Nn \l__ieeecs_artwork_file_tl
                { ieeeufgcs-student-branch-horizontal.png }
              \tl_set:Nn \l__ieeecs_artwork_viewport_tl
                { 272bp~355bp~1379bp~670bp }
              \tl_if_blank:VT \l__ieeecs_artwork_width_tl
                { \tl_set:Nn \l__ieeecs_artwork_width_tl { 60mm } }
            }
          { compact }
            {
              \tl_set:Nn \l__ieeecs_artwork_file_tl
                { ieeeufgcs-student-branch-compact.png }
              \tl_set:Nn \l__ieeecs_artwork_viewport_tl
                { 256bp~180bp~1036bp~1083bp }
              \tl_if_blank:VT \l__ieeecs_artwork_width_tl
                { \tl_set:Nn \l__ieeecs_artwork_width_tl { 35mm } }
            }
          { symbol }
            {
              \tl_set:Nn \l__ieeecs_artwork_file_tl
                { ieeeufgcs-student-branch-symbol.png }
              \tl_set:Nn \l__ieeecs_artwork_viewport_tl
                { 125bp~111bp~392bp~387bp }
              \tl_if_blank:VT \l__ieeecs_artwork_width_tl
                { \tl_set:Nn \l__ieeecs_artwork_width_tl { 18mm } }
            }
        }
      \mode_leave_vertical:
      \use:x
        {
          \exp_not:N \includegraphics
            [
              width = \tl_use:N \l__ieeecs_artwork_width_tl,
              viewport = \tl_use:N \l__ieeecs_artwork_viewport_tl,
              clip
            ]
            { \tl_use:N \l__ieeecs_artwork_file_tl }
        }
    \group_end:
  }

