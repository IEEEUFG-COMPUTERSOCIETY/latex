% Define the public color names in the selected production color model.
% Values come from the shared IEEE palette in the supplied brand guides.
\newcommand*{\ieeecs@definecolor}[3]{%
  \ifieeecs@rgb
    \definecolor{#1}{RGB}{#2}%
  \else
    \definecolor{#1}{cmyk}{#3}%
  \fi
}

