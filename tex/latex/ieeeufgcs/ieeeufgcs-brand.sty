\ifieeecs@fonts
  \RequirePackage{fontspec}
  \IfFontExistsTF{Montserrat}{%
    \newfontfamily\IEEECSHeadingFont[
      Ligatures=TeX,
      UprightFont=*-Regular,
      ItalicFont=*-Italic,
      BoldFont=*-Bold,
      BoldItalicFont=*-BoldItalic,
      FontFace={l}{n}{*-Light},
      FontFace={l}{it}{*-LightItalic},
      FontFace={mb}{n}{*-Medium},
      FontFace={mb}{it}{*-MediumItalic},
      FontFace={sb}{n}{*-SemiBold},
      FontFace={sb}{it}{*-SemiBoldItalic},
      FontFace={eb}{n}{*-ExtraBold},
      FontFace={eb}{it}{*-ExtraBoldItalic}
    ]{Montserrat}%
  }{%
    \PackageError{ieeeufgcs-brand}{Montserrat font not found}
      {Install Montserrat as an OpenType font visible to LuaLaTeX.}%
  }
  \IfFontExistsTF{OpenSans}{%
    \newfontfamily\IEEECSBodyFont[
      Ligatures=TeX,
      UprightFont=*-Regular,
      ItalicFont=*-Italic,
      BoldFont=*-Bold,
      BoldItalicFont=*-BoldItalic,
      FontFace={l}{n}{*-Light},
      FontFace={l}{it}{*-LightItalic},
      FontFace={sb}{n}{*-SemiBold},
      FontFace={sb}{it}{*-SemiBoldItalic},
      FontFace={eb}{n}{*-ExtraBold},
      FontFace={eb}{it}{*-ExtraBoldItalic}
    ]{OpenSans}%
  }{%
    \PackageError{ieeeufgcs-brand}{Open Sans font not found}
      {Install Open Sans as an OpenType font visible to LuaLaTeX.}%
  }
\else
  \newcommand*{\IEEECSHeadingFont}{\sffamily}
  \newcommand*{\IEEECSBodyFont}{\rmfamily}
\fi

\ExplSyntaxOn
\tl_new:N \l__ieeecs_artwork_file_tl
\tl_new:N \l__ieeecs_artwork_width_tl
\tl_new:N \l__ieeecs_artwork_ratio_tl
\box_new:N \l__ieeecs_artwork_box
\dim_new:N \l__ieeecs_artwork_pad_dim

\keys_define:nn { ieeeufgcs / logo }
  {
    variant .choice:,
    variant / orange .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-cs-logo-orange.pdf } },
    variant / black .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-cs-logo-black.pdf } },
    variant / white .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-cs-logo-white.pdf } },
    variant / orange-white .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-cs-logo-orange-white.pdf } },
    width .tl_set:N = \l__ieeecs_artwork_width_tl,
    clear-space .choice:,
    clear-space / true .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 0.3 } },
    clear-space / false .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 0 } },
  }

\keys_define:nn { ieeeufgcs / master-brand }
  {
    variant .choice:,
    variant / blue .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-master-brand-blue.pdf } },
    variant / black .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-master-brand-black.pdf } },
    variant / white .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-master-brand-white.pdf } },
    width .tl_set:N = \l__ieeecs_artwork_width_tl,
    clear-space .choice:,
    clear-space / print .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 1 } },
    clear-space / digital .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 0.5 } },
    clear-space / none .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 0 } },
  }

\cs_new_protected:Npn \__ieeecs_typeset_artwork:
  {
    \hbox_set:Nn \l__ieeecs_artwork_box
      {
        \includegraphics
          [ width = \l__ieeecs_artwork_width_tl ]
          { \l__ieeecs_artwork_file_tl }
      }
    \dim_set:Nn \l__ieeecs_artwork_pad_dim
      { \l__ieeecs_artwork_ratio_tl \box_ht:N \l__ieeecs_artwork_box }
    \dim_compare:nNnTF { \l__ieeecs_artwork_pad_dim } > { 0pt }
      {
        \vbox:n
          {
            \kern \l__ieeecs_artwork_pad_dim
            \hbox:n
              {
                \kern \l__ieeecs_artwork_pad_dim
                \box_use:N \l__ieeecs_artwork_box
                \kern \l__ieeecs_artwork_pad_dim
              }
            \kern \l__ieeecs_artwork_pad_dim
          }
      }
      { \box_use:N \l__ieeecs_artwork_box }
  }

\cs_new_protected:Npn \ieeecs_logo:n #1
  {
    \group_begin:
      \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-cs-logo-orange.pdf }
      \tl_set:Nn \l__ieeecs_artwork_width_tl { 45mm }
      \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 0.3 }
      \keys_set:nn { ieeeufgcs / logo } { #1 }
      \__ieeecs_typeset_artwork:
    \group_end:
  }

\cs_new_protected:Npn \ieeecs_master_brand:n #1
  {
    \group_begin:
      \tl_set:Nn \l__ieeecs_artwork_file_tl { ieeeufgcs-master-brand-blue.pdf }
      \tl_set:Nn \l__ieeecs_artwork_width_tl { 55mm }
      \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 1 }
      \keys_set:nn { ieeeufgcs / master-brand } { #1 }
      \__ieeecs_typeset_artwork:
    \group_end:
  }

\NewDocumentCommand{\IEEECSLogo}{ O{} }{\ieeecs_logo:n { #1 }}
\NewDocumentCommand{\IEEEMasterBrand}{ O{} }{\ieeecs_master_brand:n { #1 }}
\ExplSyntaxOff

