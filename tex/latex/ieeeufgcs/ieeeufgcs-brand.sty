% The CS guide explicitly shows these tint steps. White is the tint base.
\newcommand*{\ieeecs@definetints}[1]{%
  \colorlet{#1Eighty}{#1!80!IEEEWhite}%
  \colorlet{#1Sixty}{#1!60!IEEEWhite}%
  \colorlet{#1Forty}{#1!40!IEEEWhite}%
  \colorlet{#1Twenty}{#1!20!IEEEWhite}%
}
