% change its variant or size without affecting any later mark on the page.
\tl_new:N \l__ieeecs_artwork_file_tl
\tl_new:N \l__ieeecs_artwork_width_tl
\tl_new:N \l__ieeecs_artwork_ratio_tl
\tl_new:N \l__ieeecs_artwork_viewport_tl
\tl_new:N \l__ieeecs_student_branch_variant_tl
\tl_new:N \l__ieeecs_ufg_orientation_tl
\tl_new:N \l__ieeecs_ufg_variant_tl
\bool_new:N \l__ieeecs_ufg_clear_space_bool
\box_new:N \l__ieeecs_artwork_box
\dim_new:N \l__ieeecs_artwork_hpad_dim
\dim_new:N \l__ieeecs_artwork_vpad_dim
\dim_new:N \l__ieeecs_artwork_x_dim
\dim_new:N \l__ieeecs_artwork_width_dim

\msg_new:nnn { ieeeufgcs-brand } { ufg-logo-too-small }
  {
    The~UFG~#1~full-name~signature~is~below~its~official~minimum~
    width~of~#2.
  }

% Each family has its own key set because the official variants and clear-space
% vocabulary are different for the three organizations.
\keys_define:nn { ieeeufgcs / logo }
  {
    variant .choice:,
    variant / orange .code:n =
      {
        \tl_set:Nn \l__ieeecs_artwork_file_tl
          { ieeeufgcs-cs-logo-orange.pdf }
      },
    variant / black .code:n =
      {
        \tl_set:Nn \l__ieeecs_artwork_file_tl
          { ieeeufgcs-cs-logo-black.pdf }
      },
    variant / white .code:n =
      {
        \tl_set:Nn \l__ieeecs_artwork_file_tl
          { ieeeufgcs-cs-logo-white.pdf }
      },
    variant / orange-white .code:n =
      {
        \tl_set:Nn \l__ieeecs_artwork_file_tl
          { ieeeufgcs-cs-logo-orange-white.pdf }
      },
    width .tl_set:N = \l__ieeecs_artwork_width_tl,
    clear-space .choice:,
    clear-space / true .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 0.3 } },
    clear-space / false .code:n =
      { \tl_set:Nn \l__ieeecs_artwork_ratio_tl { 0 } },
  }

