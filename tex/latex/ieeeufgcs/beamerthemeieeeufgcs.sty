\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{beamerthemeieeeufgcs}
  [2026-10-04 v0.1 IEEE UFG Computer Society Beamer theme]

\RequirePackage{ieeeufgcs-brand}

\mode<presentation>

% Section pages provide the three-act rhythm used by the canonical template.
% They can be disabled for short decks with \usetheme[sectionpages=false].
\newif\ifieeecs@sectionpages
\ieeecs@sectionpagestrue
\DeclareOptionBeamer{sectionpages}[true]{%
  \csname ieeeecs@sectionpages#1\endcsname
}
\ProcessOptionsBeamer

% The body remains quiet and high contrast. Orange is reserved for emphasis
% because it does not provide sufficient contrast for small text on white.
\setbeamercolor{normal text}{fg=IEEEBlack,bg=IEEEWhite}
\setbeamercolor{structure}{fg=IEEEBlue}
\setbeamercolor{alerted text}{fg=IEEEDarkRed}
\setbeamercolor{frametitle}{fg=IEEEDarkBlue,bg=IEEEWhite}
\setbeamercolor{title page}{fg=IEEEWhite,bg=IEEEDarkBlue}
\setbeamercolor{section page}{fg=IEEEWhite,bg=IEEEBlue}
\setbeamercolor{footline}{fg=IEEEGray,bg=IEEEWhite}
\setbeamercolor{block title}{fg=IEEEBlue,bg=IEEEWhite}
\setbeamercolor{block body}{fg=IEEEBlack,bg=IEEEWhite}
\setbeamercolor{block title alerted}{fg=IEEEDarkRed,bg=IEEEWhite}
\setbeamercolor{block body alerted}{fg=IEEEBlack,bg=IEEEWhite}
\setbeamercolor{block title example}{fg=IEEEDarkGreen,bg=IEEEWhite}
\setbeamercolor{block body example}{fg=IEEEBlack,bg=IEEEWhite}
\setbeamercolor{ieeecs metric}{fg=IEEEDarkBlue,bg=IEEEWhite}
\setbeamercolor{ieeecs closing}{fg=IEEEWhite,bg=IEEEDarkBlue}

\setbeamerfont{normal text}{family=\IEEECSBodyFont,size=\normalsize}
\setbeamerfont{title}{family=\IEEECSHeadingFont,size=\LARGE,
  series=\bfseries}
\setbeamerfont{subtitle}{family=\IEEECSBodyFont,size=\large}
\setbeamerfont{author}{family=\IEEECSBodyFont,size=\normalsize}
\setbeamerfont{date}{family=\IEEECSBodyFont,size=\small}
\setbeamerfont{frametitle}{family=\IEEECSHeadingFont,size=\large,
  series=\bfseries}
\setbeamerfont{framesubtitle}{family=\IEEECSBodyFont,size=\small,
  series=\bfseries}
\setbeamerfont{section title}{family=\IEEECSHeadingFont,size=\LARGE,
  series=\bfseries}
\setbeamerfont{block title}{family=\IEEECSHeadingFont,
  series=\bfseries}
\setbeamerfont{footline}{family=\IEEECSBodyFont,size=\tiny}
\setbeamerfont{ieeecs metric value}{family=\IEEECSHeadingFont,
  size=\LARGE,series=\bfseries}
\setbeamerfont{ieeecs metric label}{family=\IEEECSBodyFont,
  size=\small}

\usefonttheme{professionalfonts}
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{items}[circle]
\setbeamertemplate{sections/subsections in toc}[circle]
\setbeamertemplate{blocks}[default]
\setbeamertemplate{bibliography item}[text]
\setbeamersize{text margin left=8mm,text margin right=8mm}

% The title page uses one dark field. Both marks retain their own protected
% areas, so the surrounding layout does not need to reproduce those rules.
\defbeamertemplate*{title page}{ieeeufgcs}{%
  \begin{beamercolorbox}[
    wd=\paperwidth,
    ht=\paperheight,
    dp=0pt,
    leftskip=9mm,
    rightskip=9mm
  ]{title page}
    % The document-cover composition is uniformly reduced by 0.72. Centers,
    % geometry, and strokes all use that same factor.
    \begin{tikzpicture}[remember picture,overlay]
      \ieeecs@brandicosahedron
        {([xshift=-38.88mm,yshift=-53.28mm]current page.north east)}
        {1.836}
        {IEEECyan}
        {1.224}
      \ieeecs@brandicosahedron
        {([xshift=-23.04mm,yshift=-66.96mm]current page.north east)}
        {0.936}
        {IEEEBlueTwenty}
        {1.44}
      \ieeecs@brandicosahedron
        {([xshift=-90mm,yshift=-64.8mm]current page.north east)}
        {5.472}
        {IEEECSOrange}
        {0.864}
    \end{tikzpicture}
    \vspace*{6mm}
    \IEEECSLogo[
      variant=orange-white,
      width=37mm,
      clear-space=false
    ]\hfill
    \UFGLogo[
      orientation=horizontal,
      variant=white,
      width=25mm,
      clear-space=false
    ]
    \vfill
    {\usebeamerfont{title}\inserttitle\par}
    \ifx\insertsubtitle\@empty
    \else
      \vspace{2mm}
      {\usebeamerfont{subtitle}\insertsubtitle\par}
    \fi
    \vspace{8mm}
    {\usebeamerfont{author}\insertauthor\par}
    \ifx\insertinstitute\@empty
    \else
      \vspace{1mm}
      {\usebeamerfont{author}\insertinstitute\par}
    \fi
    \vspace{2mm}
    {\usebeamerfont{date}\insertdate\par}
    \vfill
    \vspace*{6mm}
  \end{beamercolorbox}
}

\defbeamertemplate*{section page}{ieeeufgcs}{%
  \begin{beamercolorbox}[
    wd=.84\paperwidth,
    sep=0pt
  ]{section page}
    {\IEEECSHeadingFont\bfseries\large
      \insertsectionnumber\hspace{2mm}\textcolor{IEEECSOrange}{/}\par}
    \vspace{3mm}
    {\usebeamerfont{section title}\insertsection\par}
  \end{beamercolorbox}
}

\defbeamertemplate*{frametitle}{ieeeufgcs}{%
  \nointerlineskip
  \begin{beamercolorbox}[
    wd=\paperwidth,
    leftskip=8mm,
    rightskip=8mm,
    sep=3.2mm
  ]{frametitle}
    \usebeamerfont{frametitle}\insertframetitle
    \ifx\insertframesubtitle\@empty
    \else
      \par
      {\usebeamerfont{framesubtitle}\insertframesubtitle}
    \fi
  \end{beamercolorbox}
  \hspace*{8mm}\textcolor{IEEECSOrange}{\rule{13mm}{1.1pt}}
}

\defbeamertemplate*{footline}{ieeeufgcs}{%
  \leavevmode
  \begin{beamercolorbox}[
    wd=\paperwidth,
    ht=4.5mm,
    dp=2mm,
    leftskip=8mm,
    rightskip=8mm
  ]{footline}
    \usebeamerfont{footline}
    \insertshorttitle\hfill\insertframenumber
  \end{beamercolorbox}
}

% A compact public component for evidence and outcome slides.
\NewDocumentCommand{\IEEECSMetric}{m m}{%
  \begin{beamercolorbox}[
    wd=\linewidth,
    sep=0pt,
    left
  ]{ieeecs metric}
    \textcolor{IEEECSOrange}{\rule{\linewidth}{1.1pt}}\par
    \vspace{1.3ex}
    {\usebeamerfont{ieeecs metric value}#1\par}
    \vspace{.6ex}
    {\usebeamerfont{ieeecs metric label}#2\par}
  \end{beamercolorbox}%
}

\setbeamertemplate{title page}[ieeeufgcs]
\setbeamertemplate{section page}[ieeeufgcs]
\setbeamertemplate{frametitle}[ieeeufgcs]
\setbeamertemplate{footline}[ieeeufgcs]

\ifieeecs@sectionpages
  \AtBeginSection[]{%
    {
      \setbeamercolor{background canvas}{bg=IEEEBlue}
      \begin{frame}[plain,c,noframenumbering]
        \centering
        \sectionpage
      \end{frame}
    }
  }
\fi

\mode<all>

\endinput
